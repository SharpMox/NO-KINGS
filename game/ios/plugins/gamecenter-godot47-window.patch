+// LOCAL PATCH (NO KINGS, 2026-09-04): Godot 4.7 manages its iOS window via
+// scenes and leaves the app delegate's `window` nil, so the Godot-3-era
+// `delegate.window.rootViewController` below returned nil forever and
+// authenticate()/show_game_center() could never run. Walk the live windows
+// instead. Candidate for an upstream PR.
+static UIViewController *nk_root_controller() {
+	for (UIWindow *w in [UIApplication sharedApplication].windows) {
+		if (w.isKeyWindow && w.rootViewController) {
+			return w.rootViewController;
+		}
+	}
+	for (UIWindow *w in [UIApplication sharedApplication].windows) {
+		if (w.rootViewController) {
+			return w.rootViewController;
+		}
+	}
+	return nil;
+}
