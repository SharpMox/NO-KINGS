; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="No Kings"
config/version="0.1.0"
run/main_scene="res://scenes/Intro.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
; Android's hardware Back is the primary navigation gesture on a portrait phone,
; and Godot's default for it is to QUIT THE APP from wherever you are — including
; mid-run, where the autosave is only written at turn start, so a stray Back
; discarded the turn in progress with no warning. menu.gd and game.gd handle
; NOTIFICATION_WM_GO_BACK_REQUEST instead and navigate like a Back button should.
application/config/quit_on_go_back=false

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
GodotPlayGameServices="*uid://c4tixmu7ug5r"
PlayGamesBridge="*res://scripts/cloud/play_games_bridge.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
